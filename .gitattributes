# Use Git LFS for large binaries and images
# Add this file and then run `git lfs install` locally, then `git lfs track "*.glb" "product_photos/*"` and commit the changes.

*.glb filter=lfs diff=lfs merge=lfs -text
product_photos/* filter=lfs diff=lfs merge=lfs -text
*.stl filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
# GitHub Pages hero must be served as GLB bytes, not an LFS pointer.
Zayka.glb -filter -diff -merge -text
